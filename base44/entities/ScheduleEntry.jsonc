{
  "name": "ScheduleEntry",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string"
    },
    "employeeId": {
      "type": "string"
    },
    "employeeEmail": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "startTime": {
      "type": "string"
    },
    "endTime": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "clientId",
    "employeeId",
    "service",
    "date",
    "startTime",
    "endTime"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "client"
          }
        },
        {
          "data.employeeEmail": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        }
      ]
    }
  }
}