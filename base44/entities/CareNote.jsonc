{
  "name": "CareNote",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string"
    },
    "clientName": {
      "type": "string"
    },
    "employeeId": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "clientId",
    "note"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "caregiver"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_manager"
          }
        }
      ]
    }
  }
}