      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "serviceInterest": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "processed"
      ],
      "default": "new"
    }
  },
  "required": [
    "fullName",
    "email",
    "phone"
  ]
}