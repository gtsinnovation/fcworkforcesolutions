{
  "name": "IncidentReport",
  "type": "object",
  "properties": {
    "reportedByUserId": {
      "type": "string"
    },
    "reportedByName": {
      "type": "string"
    },
    "clientName": {
      "type": "string"
    },
    "incidentDateTime": {
      "type": "string"
    },
    "narrative": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Low"
    },
    "resolutionSteps": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "clientName",
    "incidentDateTime",
    "narrative",
    "severity"
  ]
}